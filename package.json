{
  "name": "mapa-wod-pzw-rzeszow",
  "version": "2.0.0",
  "private": true,
  "description": "Mapa wód PZW Okręgu w Rzeszowie — dane z wykazu Okręgu i BDOT10k (GUGiK)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "export": "node tools/snapshot/export.mjs",
    "validate": "node tools/snapshot/validate.mjs",
    "seed-sql": "node tools/snapshot/seed-sql.mjs",
    "kafle:login": "wrangler -c cloudflare/kafle/wrangler.toml login",
    "kafle:bucket": "wrangler -c cloudflare/kafle/wrangler.toml r2 bucket create pzw-kafle",
    "kafle:deploy": "wrangler -c cloudflare/kafle/wrangler.toml deploy",
    "kafle:tail": "wrangler -c cloudflare/kafle/wrangler.toml tail",
    "test": "node --test",
    "e2e": "playwright test",
    "e2e:przegladarki": "playwright install chromium firefox webkit",
    "e2e:raport": "playwright show-report",
    "wiki:sprawdz": "node tools/wiki/sprawdz.mjs",
    "check": "node --check vite.config.js && for f in tools/snapshot/*.mjs tools/triage/*.mjs cloudflare/kafle/*.js; do node --check \"$f\" || exit 1; done && npm run validate && npm test"
  },
  "dependencies": {
    "@geoman-io/leaflet-geoman-free": "^2.18.3",
    "@supabase/supabase-js": "^2.117.3",
    "leaflet": "^1.9.4",
    "proj4": "^2.22.0",
    "proj4leaflet": "^1.0.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "jsdom": "^30.1.2",
    "vite": "^8.3.4",
    "wrangler": "4.149.0"
  },
  "engines": {
    "node": ">=20"
  }
}
